APP_NAME="Ingeniería Web · Inventario"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.example
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
DEMO_MODE=false
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=ingenieriaweb_session
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
MAIL_MAILER=log
